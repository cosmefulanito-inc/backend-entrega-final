<h1>Reservas</h1>

<section id="bookings-list">
{{#each bookings}}
  <article data-id="{{_id}}">
    <h2>{{clientName}}</h2>
    <p>Email: {{clientEmail}}</p>
    <p>Fecha: {{date}}</p>
    <p>Hora: {{time}}</p>
    <p>Estado: {{status}}</p>
  </article>
{{else}}
  <p id="empty-bookings">No hay reservas cargadas</p>
{{/each}}
</section>
